{
  "$schema-note": "Design tokens extracted from the VLC redesign prototype (VLC Redesign.dc.html + VLC Components & Motion.dc.html). Values are CSS px at 100% scale; in Qt multiply with MainCtx.dp(x, scale).",
  "color": {
    "accent": {
      "default": "#ff8a1f",
      "hover": "#ff9a3c",
      "onAccent": "#1c1206",
      "tint12": "rgba(255,138,31,0.12)",
      "tint14": "rgba(255,138,31,0.14)",
      "border50": "rgba(255,138,31,0.50)",
      "focusRing": "rgba(255,138,31,0.18)",
      "knobHalo": "rgba(255,138,31,0.35)",
      "volumeBoost": "#ff5a1f"
    },
    "status": {
      "error": "#ff5a4e",
      "errorTint": "rgba(255,90,78,0.14)",
      "destructiveText": "#e5483c",
      "windowCloseHover": "#c42b1c"
    },
    "dark": {
      "page": "#0a0a09",
      "chrome": "#0e0d0c",
      "bg": "#121110",
      "panel": "#141312",
      "surface": "#1a1917",
      "raised": "#23211f",
      "hover": "#2c2a27",
      "hover2": "#35322f",
      "tx": "#f2efea",
      "tx2": "#cfcac3",
      "mute": "#a39e96",
      "dim": "#8d877f",
      "accTx": "#ffa552",
      "ink": "255,255,255",
      "glass": "rgba(30,29,27,0.72)",
      "fxbg": "rgba(26,25,23,0.97)",
      "placeholderStripe1": "#22201e",
      "placeholderStripe2": "#1c1a18"
    },
    "light": {
      "page": "#d6d2cc",
      "chrome": "#ebe8e4",
      "bg": "#f6f4f1",
      "panel": "#f1eeea",
      "surface": "#ffffff",
      "raised": "#ffffff",
      "hover": "#e6e2dd",
      "hover2": "#dbd6d0",
      "tx": "#1b1916",
      "tx2": "#3d3933",
      "mute": "#5f5a53",
      "dim": "#746e66",
      "accTx": "#b35300",
      "ink": "0,0,0",
      "glass": "rgba(250,249,247,0.74)",
      "fxbg": "rgba(255,255,255,0.97)",
      "placeholderStripe1": "#e7e3dd",
      "placeholderStripe2": "#dfdad3"
    },
    "overlayAlphasOfInk": {
      "divider": 0.06,
      "hairline": 0.05,
      "hoverFill": 0.07,
      "openFill": 0.09,
      "track": 0.12,
      "outlineBorder": 0.16,
      "toggleOffBorder": 0.35
    },
    "video": {
      "note": "Video surfaces stay black/dark in both themes",
      "surface": "#000000",
      "pausedBadgeBg": "rgba(0,0,0,0.55)",
      "subtitleBox": "rgba(0,0,0,0.65)"
    }
  },
  "typography": {
    "family": {
      "ui": "Segoe UI Variable Text, Segoe UI, Instrument Sans, system-ui, sans-serif",
      "mono": "JetBrains Mono, Cascadia Mono, Consolas, monospace",
      "icons": "Material Symbols Rounded (weight 400; transport icons FILL 1, utility icons FILL 0)"
    },
    "scale": {
      "display":   { "size": 48, "weight": 600, "lineHeight": 1.1, "letterSpacing": "-0.02em" },
      "pageTitle": { "size": 26, "weight": 600, "lineHeight": 1.2, "letterSpacing": "-0.01em" },
      "panelTitle":{ "size": 16, "weight": 600, "lineHeight": 1.3, "note": "15–17" },
      "body":      { "size": 13, "weight": 400, "lineHeight": 1.5 },
      "meta":      { "size": 12, "weight": 400, "lineHeight": 1.4, "color": "mute" },
      "overline":  { "size": 11, "weight": 600, "lineHeight": 1.4, "letterSpacing": "0.06em", "transform": "uppercase" },
      "timecode":  { "size": 12, "weight": 400, "features": "tabular-nums" },
      "mono":      { "size": 12, "family": "mono", "use": "paths, URLs, timecodes in dialogs, keycaps" }
    }
  },
  "size": {
    "titleBar": 40,
    "menuTitle": { "height": 28, "paddingX": 9, "radius": 5 },
    "menuItem": { "height": 30, "minMenuWidth": 290, "iconCol": 22, "radius": 5, "panelPadding": 4, "panelRadius": 8 },
    "windowButton": { "width": 46 },
    "sidebar": { "itemHeight": 36, "itemRadius": 6, "openMediaButtonHeight": 38, "padding": "14 10", "collapsesToRailBelow": 1200 },
    "iconButton": { "size": 36, "radius": 6, "glyph": 22 },
    "playButton": { "deck": 44, "nowBar": 36, "pausedOverlay": 76, "glyphDeck": 28 },
    "nowPlayingBar": { "height": 76, "thumb": "64x40", "seekTrack": 3 },
    "seek": { "track": 4, "trackHover": 6, "knob": 14, "knobHover": 16, "hitArea": 20 },
    "volume": { "track": 4, "width": 140, "max": 125, "markAt": 100 },
    "eqBand": { "height": 170, "range": 20, "knob": 14 },
    "toggle": { "width": 40, "height": 20, "knob": 12 },
    "chip": { "height": 28, "radius": 14 },
    "button": { "height": 34, "radius": 6, "paddingX": 16 },
    "input": { "height": 34, "urlHeight": 38, "selectHeight": 32, "radius": 6 },
    "playlist": { "widthL": 360, "widthM": 320, "widthS": 300, "rowHeight": 40 },
    "card": { "radius": 8, "videoAspect": "16:9", "progressBar": 3 },
    "radius": { "xs": 4, "sm": 5, "md": 6, "lg": 8, "xl": 10, "tile": 12 }
  },
  "breakpoints": {
    "L":  { "minWidth": 1600, "gridCols": 5, "playlist": 360 },
    "M":  { "minWidth": 1200, "gridCols": 4, "playlist": 320 },
    "S":  { "minWidth": 960,  "gridCols": 3, "playlist": 300, "sidebar": "icon rail" },
    "XS": { "minWidth": 800, "minHeight": 600, "gridCols": 2, "playlist": "overlay drawer", "secondaryControlsMoveToMenus": ["stop", "loop", "random", "speed", "mini", "fullscreen"] }
  },
  "motion": {
    "easing": { "decelerate": "cubic-bezier(0.2,0.8,0.2,1)", "qtEquivalent": "Easing.Bezier [0.2,0.8, 0.2,1, 1,1]" },
    "duration": { "instant": "80-100", "fast": "120-160", "standard": "200-240", "ambient": "250-900" },
    "rules": "Enter with short decelerate; exit instantly; no bounce; honour Windows 'Animation effects' off / reduced motion.",
    "animations": {
      "menuDrop":   { "ms": 140, "from": { "opacity": 0, "y": -6, "scale": 0.98 }, "origin": "top-left" },
      "popoverRise":{ "ms": 160, "from": { "opacity": 0, "y": 8, "scale": 0.98 }, "origin": "bottom" },
      "contextPop": { "ms": 120, "from": { "opacity": 0, "scale": 0.96 }, "origin": "click corner" },
      "dialog":     { "ms": 200, "backdropFadeMs": 180, "from": { "opacity": 0, "scale": 0.96 } },
      "panelSlideR":{ "ms": 220, "from": { "opacity": 0, "x": 28 } },
      "viewChange": { "ms": 240, "from": { "opacity": 0, "y": 8 } },
      "toast":      { "ms": 220, "from": { "opacity": 0, "y": 12 }, "holdMs": 2400 },
      "pausedBadge":{ "ms": 180, "kind": "pop" },
      "miniPlayer": { "ms": 240, "kind": "pop" },
      "dropTarget": { "ms": 150, "kind": "fade" },
      "spinner":    { "ms": 900, "kind": "linear infinite rotate" },
      "seekProgress":{ "ms": 250, "kind": "linear" },
      "volumeFill": { "ms": 120, "kind": "ease-out" },
      "eqBand":     { "ms": 150, "kind": "ease-out" },
      "toggleKnob": { "ms": 150 },
      "playPress":  { "ms": 100, "scale": 0.92 },
      "immersiveAutoHide": { "idleMs": 2500, "ms": 300, "to": { "opacity": 0, "y": 12 }, "hideCursor": true }
    }
  }
}
